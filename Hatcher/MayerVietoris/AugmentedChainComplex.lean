      (augmentedMiddleChainsIso A B R).inv.f (n + 1) =
        (biprod.inr : subsetChains B R ⟶
          subsetChains A R ⊞ subsetChains B R).f n := by
  rw [augmentedMiddleChainsIso_inv_f_succ]
