      (HomologicalComplex.biprodXIso
        (subsetChains A R) (subsetChains B R) n).inv =
        (biprod.inr : subsetChains B R ⟶
          subsetChains A R ⊞ subsetChains B R).f n
  rw [HomologicalComplex.inr_biprodXIso_inv]

